{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amir-roh-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d89e5bf5-5c29-480e-a883-ddff962617e6","database_name": "amir-roh-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "18ef8cef7a844dcba3632c20535fb41d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
